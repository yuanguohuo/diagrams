            <mxPoint x="350" y="760" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="U2V8Z-f0aK9JklztdvQk-7" value="GET Object：&lt;div&gt;&lt;ul&gt;&lt;li&gt;若KeyId eabled: 使用DK解密并返回；&lt;/li&gt;&lt;li&gt;否则，返回失败&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
