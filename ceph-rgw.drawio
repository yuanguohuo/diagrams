        <mxCell id="U2V8Z-f0aK9JklztdvQk-4" value="PUT Object:&lt;div&gt;&lt;ul&gt;&lt;li&gt;KeyId&lt;/li&gt;&lt;li&gt;DK明文&lt;/li&gt;&lt;li&gt;数据明文&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="120" y="350" width="100" height="100" as="geometry" />
        </mxCell>
        <mxCell id="U2V8Z-f0aK9JklztdvQk-5" value="RADOS&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Obj1：数据密文1 + DK明文1 + KeyId1 + IsServiceKey&lt;/div&gt;&lt;div&gt;Obj2：数据密文2 + DK明文2 + KeyId2 +&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;IsServiceKey&lt;/span&gt;&lt;/div&gt;&lt;div&gt;Obj3：数据密文3 + DK明文3 + KeyId3 +&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;IsServiceKey&lt;/span&gt;&lt;/div&gt;&lt;div&gt;......&lt;br&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=default;" parent="1" vertex="1">
          <mxGeometry x="80" y="680" width="330" height="130" as="geometry" />
        </mxCell>
        <mxCell id="U2V8Z-f0aK9JklztdvQk-6" value="" style="endArrow=classic;html=1;rounded=0;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;strokeColor=#006600;" parent="1" source="U2V8Z-f0aK9JklztdvQk-2" target="U2V8Z-f0aK9JklztdvQk-1" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
