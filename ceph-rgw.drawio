          <mxGeometry x="10" y="245" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="TjIE4ID5d2dV4SlR_qKl-2" value="&lt;font face=&quot;Courier New&quot;&gt;{bucketId}__&lt;b&gt;multipart&lt;/b&gt;_{ObjectName}.{random-31-bytes}_.{partNumber}&lt;/font&gt;&lt;div&gt;&lt;font face=&quot;Courier New&quot;&gt;{bucketId}__&lt;b&gt;shadow&lt;/b&gt;_{ObjectName}.{random-31-bytes}_.{partNumber}_1&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family: &amp;quot;Courier New&amp;quot;;&quot;&gt;{bucketId}__&lt;/span&gt;&lt;b style=&quot;font-family: &amp;quot;Courier New&amp;quot;;&quot;&gt;shadow&lt;/b&gt;&lt;span style=&quot;font-family: &amp;quot;Courier New&amp;quot;;&quot;&gt;_{ObjectName}.{random-31-bytes}_.{partNumber}_2&lt;/span&gt;&lt;font face=&quot;Courier New&quot;&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family: &amp;quot;Courier New&amp;quot;;&quot;&gt;......&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=default;strokeColor=default;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="160" y="320" width="620" height="80" as="geometry" />
        </mxCell>
        <mxCell id="7KXhtvtpX_vRGIll5GMJ-1" value="大于4M的Part" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="10" y="340" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="7KXhtvtpX_vRGIll5GMJ-2" value="注意：&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Head的size为0；它只存储一些xattrs；其中最重要的是manifest；&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;partNumber从1开始&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;namespace还是multipart，不要认为是multiupload object;&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="630" height="110" as="geometry" />
        </mxCell>
        <mxCell id="7KXhtvtpX_vRGIll5GMJ-3" value="&lt;div&gt;&lt;font face=&quot;Courier New&quot;&gt;查询manifest&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Courier New&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Courier New&quot;&gt;rados -p default.rgw.buckets.data getxattr &lt;b&gt;{Head}&lt;/b&gt; user.rgw.manifest &amp;gt; manifest.bin&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;ceph-dencoder type RGWObjManifest import manifest.bin decode dump_json &amp;gt; manifest.json&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="800" height="150" as="geometry" />
        </mxCell>
        <mxCell id="7KXhtvtpX_vRGIll5GMJ-4" value="&lt;font face=&quot;Courier New&quot;&gt;{bucketId}_{ObjectName}&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=default;strokeColor=default;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="160" y="160" width="620" height="40" as="geometry" />
