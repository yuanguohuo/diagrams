        <mxCell id="U2V8Z-f0aK9JklztdvQk-8" value="Redis&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;KeyId1: enabled&lt;/div&gt;&lt;div&gt;KeyId2: disabled&lt;/div&gt;&lt;div&gt;KeyId3: enabled&lt;/div&gt;&lt;div&gt;......&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
