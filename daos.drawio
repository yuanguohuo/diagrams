        <mxCell id="1dPSpmnFsEdOR2L4J735-121" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;ul&gt;&lt;li&gt;sub-region;&lt;/li&gt;&lt;li&gt;可能是其它进程创建并attach的，见d_tm_attach_path_segment()；&lt;/li&gt;&lt;li&gt;也可能是当前进程创建的，见d_tm_add_ephemeral_dir()；&lt;/li&gt;&lt;li&gt;其permission (shm_perm.uid) 和 parent一样（例如libdaos创建的sub-region，ownership是daos_agent）&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="160" width="520" x="530" y="1090" as="geometry" />
        </mxCell>
        <mxCell id="1dPSpmnFsEdOR2L4J735-122" edge="1" parent="1" source="1dPSpmnFsEdOR2L4J735-115" style="endArrow=classic;html=1;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;dashed=1;" value="">
