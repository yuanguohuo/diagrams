        <mxCell id="5uBoUbxU_h9r4BcNm5R2-31" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#009900;fillColor=none;align=left;verticalAlign=middle;rounded=0;dashed=1;" value="&lt;div style=&quot;line-height: 170%;&quot;&gt;&lt;font style=&quot;color: rgb(0, 102, 0); font-size: 14px;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 102, 0), rgb(111, 199, 111));&quot;&gt;&lt;span style=&quot;line-height: 170%;&quot;&gt;&lt;b style=&quot;&quot;&gt;A = 经 daos_server.yml 中的&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;font&gt;&lt;b style=&quot;color: light-dark(rgb(0, 102, 0), rgb(111, 199, 111)); line-height: 170%;&quot;&gt;env_pass_through 白名单过滤的系统环境变量 (A常为空，因&lt;/b&gt;&lt;font color=&quot;#006600&quot;&gt;&lt;span style=&quot;line-height: 170%;&quot;&gt;&lt;b&gt;env_pass_through空&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;b style=&quot;color: light-dark(rgb(0, 102, 0), rgb(111, 199, 111)); line-height: 170%;&quot;&gt;)；&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 102, 0);&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;span style=&quot;line-height: 170%;&quot;&gt;&lt;b&gt;B = daos_server.yml 中的 env_vars 配置的环境变量&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 102, 0);&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;span style=&quot;line-height: 170%;&quot;&gt;&lt;b&gt;C = daos_server.yml 中的配置项，对应结构体字段带有 cmdEnv 注释，例如 log_mask, log_file&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 102, 0);&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;span style=&quot;line-height: 170%;&quot;&gt;&lt;b&gt;D = A,B,C 的并集&amp;nbsp; (C覆盖B，覆盖A，即优先级 C &amp;gt; B &amp;gt; A)&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 102, 0);&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 102, 0);&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;span style=&quot;line-height: 170%;&quot;&gt;&lt;b style=&quot;&quot;&gt;daos_engine进程的实际 env 是 D；它调用C stdlib 函数 getenv，就是从D中查找；&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="789" x="-729" y="50" as="geometry" />
