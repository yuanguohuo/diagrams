        </mxCell>
        <mxCell id="5uBoUbxU_h9r4BcNm5R2-35" connectable="0" parent="5uBoUbxU_h9r4BcNm5R2-33" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" value="&lt;font style=&quot;color: rgb(0, 102, 0);&quot;&gt;getenv()&lt;/font&gt;" vertex="1">
          <mxGeometry relative="1" x="0.1487" y="-2" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5uBoUbxU_h9r4BcNm5R2-34" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#00FF00;" value="" vertex="1">
          <mxGeometry height="35.19" width="130" x="-208" y="-94.19000000000005" as="geometry" />
        </mxCell>
        <mxCell id="5uBoUbxU_h9r4BcNm5R2-36" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#FF0000;" value="" vertex="1">
          <mxGeometry height="20" width="230" x="-761" y="-931" as="geometry" />
        </mxCell>
        <mxCell id="5uBoUbxU_h9r4BcNm5R2-37" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#FF0000;" value="" vertex="1">
          <mxGeometry height="20" width="230" x="-717" y="-332" as="geometry" />
        </mxCell>
        <mxCell id="5uBoUbxU_h9r4BcNm5R2-38" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#FF0000;" value="" vertex="1">
          <mxGeometry height="20" width="330" x="-169" y="-418" as="geometry" />
        </mxCell>
        <mxCell id="5uBoUbxU_h9r4BcNm5R2-39" edge="1" parent="1" source="5uBoUbxU_h9r4BcNm5R2-37" style="endArrow=classic;html=1;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;strokeColor=#FF0000;" target="5uBoUbxU_h9r4BcNm5R2-38" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="-339" y="-540" as="sourcePoint" />
            <mxPoint x="32" y="-292" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5uBoUbxU_h9r4BcNm5R2-40" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#FF0000;" value="" vertex="1">
          <mxGeometry height="20" width="100" x="903" y="-96.19000000000005" as="geometry" />
        </mxCell>
        <mxCell id="5uBoUbxU_h9r4BcNm5R2-41" edge="1" parent="1" source="5uBoUbxU_h9r4BcNm5R2-38" style="endArrow=classic;html=1;rounded=0;strokeColor=#FF0000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="5uBoUbxU_h9r4BcNm5R2-40" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="111" y="-280" as="sourcePoint" />
            <mxPoint x="917" y="-68" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5uBoUbxU_h9r4BcNm5R2-42" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div style=&quot;line-height: 160%;&quot;&gt;&lt;font style=&quot;line-height: 160%; font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center; line-height: 160%;&quot;&gt;&lt;font style=&quot;line-height: 160%; font-size: 15px;&quot;&gt;&lt;b style=&quot;&quot;&gt;daos_engine 环境变量&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 160%;&quot;&gt;&lt;font style=&quot;line-height: 160%; font-size: 14px;&quot;&gt;daos_engine log 相关的配置：&lt;/font&gt;&lt;div&gt;&lt;ol&gt;&lt;li&gt;&lt;span style=&quot;line-height: 160%;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;代码 hard code 默认值；&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;环境变量，也就是上述集合D；&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;dmg server set-logmasks;&lt;/font&gt;&lt;/li&gt;&lt;/ol&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;log相关环境变量（上述集合D）：&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;DD_SUBSYS：&lt;b&gt;&lt;font style=&quot;color: rgb(204, 0, 0);&quot;&gt;开启哪些子系统的日志&lt;/font&gt;&lt;/b&gt;。定义在engines[].env_vars里。&lt;b&gt;若不定义，则全开启。若定义，则只有名单内的开启&lt;/b&gt;。&lt;/font&gt;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;若开启：级别由D_LOG_MASK定义。&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;若不开：级别是ERR及更高。&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;但若同时配置DD_SUBSYS和D_LOG_MASK，会合并到后者，并删掉前者。daos_engine 会认为全部开启，并按后者决定各个子系统的日志级别。合并逻辑见&amp;nbsp;&lt;span style=&quot;font-family: &amp;quot;Courier New&amp;quot;, Menlo, Monaco, monospace, Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-weight: 600; background-color: color(srgb 0.8 0.8 0.8 / 0.08);&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;processLogEnvs() 函数。&amp;nbsp;&lt;/font&gt;&lt;/span&gt;D_LOG_MASK=INFO；DD_SUBSYS=mgmt；合并结果： D_LOG_MASK=“ERR,mgmt=INFO”；相当于除了mgmt之外全不开（只打印ERR及以上）；mgmt是INFO。&lt;b&gt;其实和不合并效果一样&lt;/b&gt;。&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;D_LOG_MASK：可以定义在 engines[].env_vars里，但更常见的是通过engines[].log_mask设置（优先级更高）。&lt;b&gt;&lt;font style=&quot;color: rgb(204, 0, 0);&quot;&gt;定义每个子系统(facility/subsys)的日志级别&lt;/font&gt;；&lt;/b&gt;&lt;/font&gt;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;engines[].log_mask: INFO&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; //全局级别是INFO；&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;engines[].log_mask: ERR,mgmt=DEBUG,bio=INFO&amp;nbsp; &amp;nbsp; //全局级别是ERR，但mgmt子系统是DEBUG,bio子系统是INFO&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;DD_MASK：定义在 engines[].env_vars里。考虑一个子系统，若它的D_LOG_MASK是DEBUG（可以全局是DEBUG，也可以它自己是DEBUG），就可以通过DD_MASK进一步控制debug stream。&lt;/font&gt;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;若不设置DD_MASK：则所有DEBUG日志都打印。&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;若设置DD_MASK：只打印命中的DEBUG日志。&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;可选值：&lt;/span&gt;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;md&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;...&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Subsystem vs Stream：多个subsystem可以包含同一个stream（这是常态）。&lt;b&gt;subsystem 纵着切；stream横着切&lt;/b&gt;。&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;总结：&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;3级控制：&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;DD_SUBSYS：开启谁；D_LOG_MASK：开启的是什么级别；DD_MASK：若开启的是DEBUG，进一步控制stream；&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;术语Subsystem vs Facility：&lt;/font&gt;&lt;/span&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px;&quot;&gt;文档和配置（&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; font-family: &amp;quot;Courier New&amp;quot;, Menlo, Monaco, monospace, Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;DD_SUBSYS&lt;/code&gt;&lt;span style=&quot;font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px;&quot;&gt;、&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; font-family: &amp;quot;Courier New&amp;quot;, Menlo, Monaco, monospace, Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;ValidateLogSubsystems&lt;/code&gt;&lt;span style=&quot;font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px;&quot;&gt;&amp;nbsp;等）里说&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600; font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px;&quot;&gt;subsystem&lt;/span&gt;&lt;span style=&quot;font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px;&quot;&gt;；Gurt / C 侧结构体、注释里常说&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;font-semibold&quot; data-streamdown=&quot;strong&quot; style=&quot;--tw-font-weight: 600; font-weight: 600; font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px;&quot;&gt;facility&lt;/span&gt;&lt;span style=&quot;font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px;&quot;&gt;（&lt;/span&gt;&lt;code class=&quot;md-inline-variable-like&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; font-family: &amp;quot;Courier New&amp;quot;, Menlo, Monaco, monospace, Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;dlog_fac&lt;/code&gt;&lt;span style=&quot;font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px;&quot;&gt;、&lt;/span&gt;&lt;code class=&quot;&quot; style=&quot;padding: 1.5px 4px; border-radius: 5px; font-family: &amp;quot;Courier New&amp;quot;, Menlo, Monaco, monospace, Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; font-size: 0.9em; line-height: 1.4; word-break: break-all;&quot;&gt;D_LOGFAC&lt;/code&gt;&lt;span style=&quot;font-family: -apple-system, &amp;quot;system-ui&amp;quot;, sans-serif; font-size: 13px;&quot;&gt;）。&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="675" width="1368" x="-728" y="255" as="geometry" />
        </mxCell>
        <mxCell id="2ZgpSwJgNeICkIfWV25v-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div style=&quot;text-align: center; line-height: 160%;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;client 端环境变量&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 160%;&quot;&gt;&lt;span style=&quot;font-size: 14px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 160%;&quot;&gt;&lt;ul&gt;&lt;li&gt;&lt;font&gt;client 端没有 env_pass_through 来过滤哪些环境变量能够传入进程。因此，export 设置的环境变量，都可以被 getenv() 获得。例如&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;D_LOG_FILE，&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;D_LOG_MASK，DD_MASK, CRT_TIMEOUT，等；&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font&gt;其中&amp;nbsp;CRT_TIMEOUT 等&amp;nbsp;net/cart 相关的环境变量，&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;服务端 (mgmt) 也可以通过 client_env_vars 来设置。Client 调用&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;GetAttachInfo，返回消息&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;GetAttachInfoResp.&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;ClientNetHint.&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;EnvVars 包含的就是 client_env_vars （以及服务端可能塞入的auth key等其它变量）。但以本地 export&amp;nbsp;&amp;nbsp;&lt;/span&gt;CRT_TIMEOUT=x 设置优先；见dc_mgmt_net_cfg_init() --&amp;gt;&amp;nbsp;d_setenv(v_name, v_value, 0); 最后的参数0，表示不覆盖原有值。&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="310" width="1368" x="-717" y="880" as="geometry" />
        </mxCell>
        <mxCell id="2ZgpSwJgNeICkIfWV25v-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div style=&quot;text-align: center; line-height: 160%;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;client 端日志&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 160%;&quot;&gt;&lt;span style=&quot;font-size: 14px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 160%;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font&gt;由于client端没有配置文件，主要靠环境变量；&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 160%;&quot;&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font&gt;注意1：client 端没有 env_pass_through 来过滤哪些环境变量能够传入进程。&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;font&gt;注意2：服务端设置 client_env_vars 无法用来设置日志相关的环境变量。因为，daos_init()中先调用daos_debug_init()初始化日志，然后才调用dc_mgmt_cache_attach_info()和dc_mgmt_net_cfg_init() 获取服务端设置的 client_env_vars。另外，client_env_vars是通过&amp;nbsp;mgmtpb.ClientNetHint.EnvVars 传给 client 的（client通过 get attach info 获取的，C语言的proto类是 struct&amp;nbsp; _Mgmt__ClientNetHint），由ClientNetHint名字可以看出，client_env_vars 是用来传递 net 相关的环境变量。&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 160%;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 160%;&quot;&gt;&lt;font&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;daos_init() --&amp;gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;daos_debug_init(&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;NULL&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;) --&amp;gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;daos_debug_init_ex(NULL,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;DLOG_ERR&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;):&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 160%;&quot;&gt;&lt;font&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; - 获取环境变量&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;D_LOG_FILE&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 160%;&quot;&gt;&lt;font&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&amp;nbsp; &amp;nbsp; -&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;d_log_init_adv() --&amp;gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;d_log_open(): 获取环境变量&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;D_LOG_SIZE，&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 160%;&quot;&gt;&lt;font&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; -&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;d_log_sync_mask()：获取环境变量&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;D_LOG_MASK,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;DD_MASK&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 160%;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 160%;&quot;&gt;&lt;font&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;export D_LOG_FILE=&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;/var/log/daos/daos_client.log&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 160%;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font&gt;export D_LOG_MASK=DEBUG&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 160%;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font&gt;export DD_MASK=md&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="360" width="1368" x="-717" y="1170" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
