        <mxCell id="Rnl9G9QSr9KmMglBEjPI-54" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;eventfd&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
