          <mxGeometry x="266.1300000000001" y="598" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="R7NxRwsbaFrteS3I5hau-8" value="" style="sketch=0;pointerEvents=1;shadow=0;dashed=0;html=1;strokeColor=none;fillColor=#434445;aspect=fixed;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;outlineConnect=0;shape=mxgraph.vvd.cpu;container=0;" parent="Rnl9G9QSr9KmMglBEjPI-18" vertex="1">
