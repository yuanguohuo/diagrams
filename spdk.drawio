        <mxCell id="z1ke1N7C8h1OpzXXo9s7-10" value="&lt;div style=&quot;font-size: 14px;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot; face=&quot;Courier New&quot;&gt;&lt;div&gt;--------------------------------------- server side ---------------------------------------&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;bash -x scripts/setup.sh &amp;gt; log 2&amp;gt;&amp;amp;1&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;nohup ./bin/iscsi_tgt &amp;gt; iscsi_tgt.log 2&amp;gt;&amp;amp;1 &amp;amp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;./scripts/rpc.py bdev_malloc_create -b Malloc0 64 512&lt;/div&gt;&lt;div&gt;./scripts/rpc.py bdev_malloc_create -b Malloc1 64 512&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;./scripts/rpc.py bdev_nvme_attach_controller -b NVMe1 -t PCIe -a 0000:3c:00.0&lt;/div&gt;&lt;div&gt;./scripts/rpc.py bdev_nvme_attach_controller -b NVMe2 -t PCIe -a 0000:3d:00.0&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;./scripts/rpc.py bdev_rbd_register_cluster&amp;nbsp; --config-file /etc/ceph/ceph.conf --user iscsigw --key-file /etc/ceph/ceph.client.admin.keyring&amp;nbsp; rbd_cluster1&lt;/div&gt;&lt;div&gt;./scripts/rpc.py bdev_rbd_register_cluster&amp;nbsp; --config-file /etc/ceph/ceph.conf --user iscsigw --key-file /etc/ceph/ceph.client.admin.keyring&amp;nbsp; rbd_cluster2&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;rbd create zhuhai_rbd_10 --size=1024G&lt;/div&gt;&lt;div&gt;rbd create zhuhai_rbd_11 --size=1024G&lt;/div&gt;&lt;div&gt;./scripts/rpc.py bdev_rbd_create --user iscsigw rbd zhuhai_rbd_10 512 -c rbd_cluster1&lt;/div&gt;&lt;div&gt;./scripts/rpc.py bdev_rbd_create --user iscsigw rbd zhuhai_rbd_11 512 -c rbd_cluster1&lt;/div&gt;&lt;div&gt;rbd create zhuhai_rbd_20 --size=2048G&lt;/div&gt;&lt;div&gt;rbd create zhuhai_rbd_21 --size=2048G&lt;/div&gt;&lt;div&gt;./scripts/rpc.py bdev_rbd_create --user iscsigw rbd zhuhai_rbd_20 512 -c rbd_cluster2&lt;/div&gt;&lt;div&gt;./scripts/rpc.py bdev_rbd_create --user iscsigw rbd zhuhai_rbd_21 512 -c rbd_cluster2&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;./scripts/rpc.py bdev_get_bdevs&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;./scripts/rpc.py iscsi_create_portal_group 1 112.13.77.31:3260&lt;/div&gt;&lt;div&gt;./scripts/rpc.py iscsi_create_initiator_group 2 ANY 112.13.77.0/26&lt;/div&gt;&lt;div&gt;./scripts/rpc.py iscsi_create_target_node zhuhaitarget &quot;DataDisk1&quot; &quot;Malloc0:0 Malloc1:1 NVMe1n1:2 NVMe2n1:3 Ceph0:4 Ceph1:5 Ceph2:6 Ceph3:7&quot; 1:2 64 -d&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;./scripts/rpc.py iscsi_get_target_nodes&lt;/div&gt;&lt;div&gt;./scripts/rpc.py iscsi_delete_target_node iqn.2016-06.io.spdk:zhuhaitarget&lt;/div&gt;&lt;div&gt;./scripts/rpc.py iscsi_get_portal_groups&lt;/div&gt;&lt;div&gt;./scripts/rpc.py iscsi_delete_portal_group 1&lt;/div&gt;&lt;div&gt;./scripts/rpc.py iscsi_get_initiator_groups&lt;/div&gt;&lt;div&gt;./scripts/rpc.py iscsi_delete_initiator_group 2&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;./scripts/rpc.py bdev_rbd_delete Ceph0&lt;/div&gt;&lt;div&gt;./scripts/rpc.py bdev_rbd_delete Ceph1&lt;/div&gt;&lt;div&gt;./scripts/rpc.py bdev_rbd_delete Ceph2&lt;/div&gt;&lt;div&gt;./scripts/rpc.py bdev_rbd_delete Ceph3&lt;/div&gt;&lt;div&gt;rbd rm zhuhai_rbd_10&lt;/div&gt;&lt;div&gt;rbd rm zhuhai_rbd_11&lt;/div&gt;&lt;div&gt;rbd rm zhuhai_rbd_20&lt;/div&gt;&lt;div&gt;rbd rm zhuhai_rbd_20&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;./scripts/rpc.py bdev_rbd_get_clusters_info&lt;/div&gt;&lt;div&gt;./scripts/rpc.py bdev_rbd_unregister_cluster rbd_cluster1&lt;/div&gt;&lt;div&gt;./scripts/rpc.py bdev_rbd_unregister_cluster rbd_cluster2&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;./scripts/rpc.py bdev_malloc_delete Malloc0&lt;/div&gt;&lt;div&gt;./scripts/rpc.py bdev_malloc_delete Malloc1&lt;/div&gt;&lt;div&gt;./scripts/rpc.py bdev_nvme_detach_controller NVMe1&lt;/div&gt;&lt;div&gt;./scripts/rpc.py bdev_nvme_detach_controller NVMe2&lt;/div&gt;&lt;div&gt;./scripts/rpc.py bdev_get_bdevs&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;#fg and CTRL-C to stop ./bin/iscsi_tgt&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;./scripts/setup.sh reset&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;--------------------------------------- client side ---------------------------------------&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;yum install -y iscsi-initiator-utils&lt;/div&gt;&lt;div&gt;iscsiadm -m discovery -t sendtargets -p 112.13.77.31&lt;/div&gt;&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
