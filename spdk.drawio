        <mxCell id="4yErHE1b_O7wIYgZHDu0-25" value="Guest Kernel Space" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="4yErHE1b_O7wIYgZHDu0-19" vertex="1">
